<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>iOSCopy</string>
    <key>items</key>
    <array>
        <!-- Header -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>iOSCopy — Clipboard Manager</string>
            <key>footerText</key>
            <string>A modern clipboard history manager for iOS.</string>
        </dict>

        <!-- Enable Toggle -->
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>enabled</string>
            <key>label</key>
            <string>Enable iOSCopy</string>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <!-- Open Triggers -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Open iOSCopy</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>triggerKeyboardSwipeUp</string>
            <key>label</key>
            <string>Keyboard Swipe Up</string>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>triggerExternalKeyboardShortcut</string>
            <key>label</key>
            <string>External Keyboard Shortcut</string>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>triggerDictationKey</string>
            <key>label</key>
            <string>Replace Dictation Key</string>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <!-- Storage Settings -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Storage</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSEditTextCell</string>
            <key>default</key>
            <integer>50</integer>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>maxItems</string>
            <key>label</key>
            <string>Max History Items</string>
            <key>placeholder</key>
            <string>50</string>
            <key>isNumeric</key>
            <true/>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>recordImages</string>
            <key>label</key>
            <string>Record Images</string>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>imageTextSearchEnabled</string>
            <key>label</key>
            <string>Image Text Search</string>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>recordURLs</string>
            <key>label</key>
            <string>Record URLs</string>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSEditTextCell</string>
            <key>default</key>
            <integer>30</integer>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>cleanupDays</string>
            <key>label</key>
            <string>Auto-Cleanup Days</string>
            <key>placeholder</key>
            <string>30</string>
            <key>isNumeric</key>
            <true/>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <!-- Appearance -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Appearance</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <false/>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>verticalLayoutEnabled</string>
            <key>label</key>
            <string>Vertical List Layout</string>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>autoClose</string>
            <key>label</key>
            <string>Auto-Close After Copy</string>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>hapticFeedback</string>
            <key>label</key>
            <string>Haptic Feedback</string>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <!-- Paste Behavior -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Paste</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <false/>
            <key>defaults</key>
            <string>com.ssdsl.ioscopy</string>
            <key>key</key>
            <string>textPasteCompatibilityMode</string>
            <key>label</key>
            <string>Text Compatibility Paste Mode</string>
            <key>PostNotification</key>
            <string>com.ssdsl.ioscopy/prefschanged</string>
        </dict>

        <!-- Data Management -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Data Management</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>Clear All History</string>
            <key>action</key>
            <string>clearAllData</string>
            <key>isDestructive</key>
            <true/>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>Build Image Text Index</string>
            <key>action</key>
            <string>buildImageTextIndex</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>Reset Settings</string>
            <key>action</key>
            <string>resetPreferences</string>
        </dict>

        <!-- About -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>About</string>
            <key>footerText</key>
            <string>iOSCopy v1.8.0
Clipboard Manager
Developed by newbie and Codex</string>
        </dict>

    </array>
</dict>
</plist>
