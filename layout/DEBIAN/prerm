#!/bin/sh

OCRD_PLIST=""
for candidate in \
  "/Library/LaunchDaemons/com.ssdsl.ioscopy.ocrd.plist" \
  "/var/jb/Library/LaunchDaemons/com.ssdsl.ioscopy.ocrd.plist"; do
  if [ -f "$candidate" ]; then
    OCRD_PLIST="$candidate"
    break
  fi
done

if [ -n "$OCRD_PLIST" ]; then
  launchctl unload "$OCRD_PLIST" 2>/dev/null || true
fi

exit 0
